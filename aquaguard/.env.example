# Backend (FastAPI) — copy to backend environment; never commit real values.
CORS_ORIGINS=http://localhost:3000
# Optional LLM mode for the Copilot (fallback mode works without it)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_PROVIDER=anthropic
COPILOT_RATE_PER_MIN=20
# Resilience switches
AQUAGUARD_OFFLINE=0          # 1 = never call external APIs (serve cache/sample)
AQUAGUARD_FORCE_SAMPLE=0     # 1 = ignore the database and serve data/sample
# AQUAGUARD_DB_PATH=/data/aquaguard.db

# Frontend (Next.js) — set in frontend/.env.local or the Vercel project
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_API_MODE=live    # "mock" serves frontend/public/mocks without a backend
