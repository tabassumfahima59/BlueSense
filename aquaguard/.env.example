# AquaGuard environment — copy to backend/.env (or the host's settings). Never commit real values.
# Secrets below MUST stay empty in this file and must never use a NEXT_PUBLIC_ name.

# --- Web ---------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000          # comma-separated frontend origins allowed by CORS

# --- Database ----------------------------------------------------------------------------------
# AQUAGUARD_DB_PATH=/data/aquaguard.db      # default: data/aquaguard.db
# AQUAGUARD_BACKUP_DIR=/data/backups         # default: data/backups (pre-migration / pre-import backups)
AQUAGUARD_MIGRATE_ON_STARTUP=1              # apply pending migrations at API startup (existing DB only, backup first)
AQUAGUARD_BOOTSTRAP_ON_STARTUP=1            # DB missing at startup: build it from data/processed (original dates; shown stale)

# --- Data sources (P2) ---------------------------------------------------------------------------
# OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_API_KEY=                          # optional, only for a paid Open-Meteo plan (free tier: non-commercial)
# AQUASTAT_API_URL=https://api.data.apps.fao.org/api/v2/bigquery
# GRACE_CSR_URL=https://download.csr.utexas.edu/outgoing/grace/RL0603_mascons/CSR_GRACE_GRACE-FO_RL0603_Mascons_all-corrections.nc
EARTHDATA_TOKEN=                            # future JPL GRACE adapter only (Deviation D1); empty = not_configured
# GRACE_MAX_DOWNLOAD_BYTES=629145600         # refuse a GRACE file larger than this (default 600 MiB)

# --- Scheduler (P2) -------------------------------------------------------------------------------
AQUAGUARD_SCHEDULER_ENABLED=0
SYNC_FORECAST_MINUTES=60
SYNC_ARCHIVE_HOURS=24
SYNC_AQUASTAT_DAYS=7
SYNC_GRACE_HOURS=24
SYNC_STALE_FACTOR=2                         # status 'stale' when the last success is older than factor x cadence
# SYNC_INTERVAL_OVERRIDE_S=60                # verification only: every job runs at this interval (seconds)

# --- HTTP client ----------------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT_S=10
HTTP_READ_TIMEOUT_S=60
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_S=1
HTTP_BACKOFF_MAX_S=60
HTTP_RETRY_AFTER_MAX_S=300

# --- Security -------------------------------------------------------------------------------------
ADMIN_TOKEN=                                # server-side only; protects POST /api/sync/{source}. Empty = admin disabled

# --- AI Copilot (M8) ------------------------------------------------------------------------------
LLM_PROVIDER=gemini                         # gemini | anthropic; never switches provider automatically
GEMINI_API_KEY=                             # server-side only; empty = Copilot not_configured (no fallback answers)
ANTHROPIC_API_KEY=                          # server-side only; used when LLM_PROVIDER=anthropic
LLM_API_KEY=                                # legacy alias of ANTHROPIC_API_KEY
LLM_MODEL=                                  # default: gemini-3.6-flash (gemini) / claude-opus-5-5 (anthropic)
GEMINI_THINKING_LEVEL=low                   # minimal | low | medium | high (fewer tokens = more free quota)
LLM_CALL_TIMEOUT_S=30                       # one model call: connect / gap between streamed chunks
COPILOT_RATE_PER_MIN=5                      # questions per minute per visitor (IP and browser)
COPILOT_DAILY_PER_CLIENT=30                 # questions per day per visitor
COPILOT_DAILY_MODEL_CALLS=200               # model calls per day for the whole site (keep below the provider quota)
COPILOT_MAX_CONCURRENT=2                    # questions answered at the same time
COPILOT_MAX_MODEL_CALLS=4                   # model calls per question (tool rounds + answer)
COPILOT_MAX_OUTPUT_TOKENS=4096
COPILOT_DEADLINE_S=90                       # whole question

# --- Resilience -----------------------------------------------------------------------------------
AQUAGUARD_OFFLINE=0                         # 1 = never call external APIs (scheduled sync jobs are skipped)

# --- Frontend (Next.js) — frontend/.env.local or the Vercel project. Public values only. ----------
NEXT_PUBLIC_API_URL=http://localhost:8001
